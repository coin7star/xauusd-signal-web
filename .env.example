# Copy file ini jadi .env (jangan di-commit ke GitHub!)
# Set nilai aslinya di Cloudflare Pages → Settings → Environment Variables

# Claude API Key (dari console.anthropic.com)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Firebase (opsional, bisa langsung di firebase.js untuk config publik)
# Firebase config sudah aman di frontend karena dilindungi Firebase Rules
FIREBASE_DATABASE_URL=https://nama-project-default-rtdb.firebaseio.com
